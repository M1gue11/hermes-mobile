  "mvp_observed_contract": {
    "source": "Observed in Hermes 0.18.2 source at source_commit; not OpenAPI.",
    "identifier_semantics": {
      "durable": [
        "stored_session_id",
        "session_key"
      ],
      "live": "session_id returned by session.create or session.resume; use it for prompt.submit, session.history, session.steer, session.interrupt, and approval.respond."
    },
    "methods": [
      {
        "method": "session.create",
        "required_params": [],
        "optional_params": ["cols (default 80)", "messages", "title", "parent_session_id", "cwd", "source", "profile", "model", "provider", "reasoning_effort", "fast", "close_on_disconnect"],
        "result": ["session_id", "stored_session_id", "message_count", "messages", "info"]
      },
      {
        "method": "session.list",
        "required_params": [],
        "optional_params": ["limit (default 200)"],
        "result": ["sessions[]: id, title, preview, started_at, message_count, source"]
      },
      {
        "method": "session.most_recent",
        "required_params": [],
        "optional_params": [],
        "result": ["session_id (may be null)", "when present: title, started_at, source"]
      },
      {
        "method": "session.resume",
        "required_params": ["session_id"],
        "optional_params": ["cols (default 80)", "profile", "lazy", "source", "close_on_disconnect", "eager_build"],
        "result": ["session_id (live)", "resumed", "message_count", "messages", "info", "inflight", "running", "session_key", "started_at", "status"]
      },
      {
        "method": "session.history",
        "required_params": ["session_id (live id returned by create/resume)"],
        "optional_params": [],
        "result": ["count", "messages"]
      },
      {
        "method": "prompt.submit",
        "required_params": ["session_id", "text"],
        "optional_params": ["truncate_before_user_ordinal"],
        "result": ["status: streaming", "or error envelope"]
      },
      {
        "method": "session.steer",
        "required_params": ["session_id", "text (non-empty)"],
        "optional_params": [],
        "result": ["status: queued|rejected", "text"]
      },
      {
        "method": "session.interrupt",
        "required_params": ["session_id"],
        "optional_params": [],
        "result": ["status: interrupted"]
      },
      {
        "method": "clarify.respond",
        "required_params": ["request_id", "answer"],
        "optional_params": [],
        "result": ["status: ok", "or error when there is no pending prompt"]
      },
      {
        "method": "approval.respond",
        "required_params": ["session_id"],
        "optional_params": ["choice (default deny)", "all (default false)"],
        "result": ["resolved"]
      }
    ]
  }
